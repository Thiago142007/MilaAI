# MILA 3D AI Configuration

NOVA_HOST=127.0.0.1
NOVA_PORT=8765

# ── LLM Configuration ───────────────────────────────────────────────────
NOVA_LLM_BASE_URL=https://ollama.com
NOVA_LLM_PROTOCOL=ollama
NOVA_LLM_API_KEY=your_api_key_here
NOVA_LLM_MODEL=minimax-m3:cloud
NOVA_LLM_VISION_MODEL=minimax-m3:cloud
NOVA_LLM_TEMPERATURE=0.2
NOVA_LLM_MAX_TOKENS=4096
NOVA_LLM_TIMEOUT_SECONDS=300

# ── Kokoro-82M Local TTS Configuration ──────────────────────────────────
TTS_VOICE=pf_dora
TTS_SPEED=1.0
TTS_VOLUME=1.0
TTS_DEVICE=auto
TTS_CACHE_ENABLED=true

# Modo de autonomia: manual | assisted | autonomous
NOVA_AUTONOMY_MODE=assisted
NOVA_AGENT_MAX_STEPS=25
NOVA_AGENT_LOOP_DETECTION_THRESHOLD=3
NOVA_EMERGENCY_HOTKEY=ctrl+alt+shift+x
